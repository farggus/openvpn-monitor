# OpenVPN Monitor Configuration
# Copy this file to .env and adjust the values as needed

# Domain name for Traefik routing (used in docker-compose.yml)
OPENVPN_DOMAIN=localhost

# Timezone for session duration calculations
# OPENVPN_MONITOR_TZ=Europe/Bucharest

# Path to OpenVPN status log (inside container)
# OPENVPN_STATUS_LOG=/var/log/openvpn/status.log

# Path to session history JSON file
# OPENVPN_HISTORY_LOG=/app/data/session_history.json

# Path to active sessions JSON file
# OPENVPN_ACTIVE_SESSIONS=/app/data/active_sessions.json

# Path to server status JSON file
# OPENVPN_SERVER_STATUS=/app/data/server_status.json

# Path to traffic metrics JSON file
# OPENVPN_TRAFFIC_METRICS=/app/data/traffic_metrics.json

# Enable server geolocation (default: false)
# Set to "true" to fetch and display server's geographical location
# Warning: This reveals the physical location of your server
# OPENVPN_SERVER_GEOLOCATION=false
