# OpenVPN Monitor Configuration
# Copy this file to .env and adjust the values as needed

# Domain name for Traefik routing (used in docker-compose.yml)
OPENVPN_DOMAIN=localhost

# Timezone for session duration calculations
# OPENVPN_MONITOR_TZ=Europe/Bucharest

# Path to OpenVPN status log (inside container)
# OPENVPN_STATUS_LOG=/var/log/openvpn/status.log

# Path to session history JSON file
# OPENVPN_HISTORY_LOG=/app/data/session_history.json

# Path to active sessions JSON file
# OPENVPN_ACTIVE_SESSIONS=/app/data/active_sessions.json

# Path to server status JSON file
# OPENVPN_SERVER_STATUS=/app/data/server_status.json

# Path to traffic metrics JSON file
# OPENVPN_TRAFFIC_METRICS=/app/data/traffic_metrics.json

# Enable server geolocation (default: false)
# Set to "true" to fetch and display server's geographical location
# Warning: This reveals the physical location of your server
# OPENVPN_SERVER_GEOLOCATION=false

# ============================================================================
# Traefik Basic Authentication (Optional)
# ============================================================================
#
# To enable Basic Auth protection for the web interface, you need to:
# 1. Generate a password hash using htpasswd
# 2. Add it to docker-compose.yml in the Traefik labels section
#
# IMPORTANT: Dollar sign ($) escaping in docker-compose.yml
# ============================================================================
# Docker Compose uses $ for variable substitution, so you MUST escape it:
# - htpasswd generates: username:$apr1$xyz$abc
# - In docker-compose.yml use: username:$$apr1$$xyz$$abc
# - Every single $ must become $$
#
# Why? Docker Compose will replace $$ with $ when reading the file.
# Without escaping, $apr1 would be treated as a variable name.
#
# Example: Generate password hash
# ============================================================================
# htpasswd -nb username password
#
# Output from htpasswd:
#   openvpn:$apr1$AxHp9Acv$so9EImC8Jv7YULdyknjHQ.
#
# Use in docker-compose.yml (escape all $ with $$):
#   - "traefik.http.middlewares.openvpn-user-auth.basicauth.users=openvpn:$$apr1$$AxHp9Acv$$so9EImC8Jv7YULdyknjHQ."
#
# For multiple users, separate with comma:
#   - "traefik.http.middlewares.openvpn-user-auth.basicauth.users=user1:$$apr1$$..., user2:$$apr1$$..."
#
# Then attach middleware to router:
#   - "traefik.http.routers.openvpn-secure.middlewares=openvpn-user-auth"
# ============================================================================
